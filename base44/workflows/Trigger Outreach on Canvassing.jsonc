{
  "name": "Trigger Outreach on Canvassing",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"canvassed\") != null) and (.trigger.data.canvassed == true)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Contact"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "trigger_outreach_on_canvassing",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processOutreachSequences",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "processOutreachSequences"
  }
}