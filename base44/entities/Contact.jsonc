{
  "name": "Contact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Full name of the voter/contact"
    },
    "address": {
      "type": "string",
      "description": "Street address"
    },
    "postcode": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "latitude": {
      "type": "number",
      "description": "Geocoded latitude"
    },
    "longitude": {
      "type": "number",
      "description": "Geocoded longitude"
    },
    "registered_voter": {
      "type": "boolean",
      "default": false,
      "description": "Whether this person is on the electoral roll"
    },
    "support_level": {
      "type": "string",
      "enum": [
        "strong_supporter",
        "leaning",
        "undecided",
        "opposed",
        "unknown"
      ],
      "default": "unknown"
    },
    "notes": {
      "type": "string"
    },
    "canvassed": {
      "type": "boolean",
      "default": false
    },
    "canvass_date": {
      "type": "string",
      "format": "date"
    },
    "key_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "volunteer": {
      "type": "boolean",
      "default": false,
      "description": "Whether this contact has volunteered"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Organizational tags (e.g. 'Requires Follow-up', 'Display Poster')"
    },
    "consent_given": {
      "type": "boolean",
      "default": false,
      "description": "Whether the contact has given explicit data processing consent"
    },
    "consent_date": {
      "type": "string",
      "format": "date",
      "description": "Date consent was recorded"
    },
    "consent_method": {
      "type": "string",
      "enum": [
        "door_knock",
        "phone",
        "email",
        "online_form",
        "electoral_roll",
        "unknown"
      ],
      "default": "unknown",
      "description": "How consent was obtained"
    },
    "data_retention_exempt": {
      "type": "boolean",
      "default": false,
      "description": "If true, this contact is exempt from automated data retention deletion"
    },
    "deletion_requested": {
      "type": "boolean",
      "default": false,
      "description": "Right to be forgotten request pending"
    },
    "deletion_requested_date": {
      "type": "string",
      "format": "date",
      "description": "When the deletion was requested"
    }
  },
  "required": [
    "name"
  ]
}