{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "organizer",
        "canvasser",
        "viewer"
      ],
      "default": "viewer",
      "description": "User's primary role"
    },
    "custom_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extra permissions granted on top of the role defaults"
    },
    "revoked_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Permissions explicitly removed from the role defaults"
    }
  }
}