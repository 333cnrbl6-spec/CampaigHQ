{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "Platform-level role (admin has access to all campaigns)"
    },
    "campaign_memberships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "campaign_id": {
            "type": "string",
            "description": "Campaign ID"
          },
          "role": {
            "type": "string",
            "enum": [
              "volunteer",
              "organiser",
              "campaign_admin"
            ],
            "description": "Role within this campaign"
          },
          "added_date": {
            "type": "string",
            "format": "date-time",
            "description": "When user was added to campaign"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "removed"
            ],
            "default": "active"
          }
        },
        "required": [
          "campaign_id",
          "role"
        ]
      },
      "description": "List of campaigns this user has access to with their role in each"
    },
    "campaign_id": {
      "type": "string",
      "description": "Deprecated: use campaign_memberships instead. Kept for backward compatibility."
    },
    "default_campaign_id": {
      "type": "string",
      "description": "Which campaign to load on login (if user is member of multiple)"
    }
  }
}