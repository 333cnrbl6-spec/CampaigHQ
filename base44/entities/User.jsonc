{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "organizer",
        "canvasser",
        "viewer"
      ],
      "default": "viewer",
      "description": "User's primary role"
    },
    "campaign_id": {
      "type": "string",
      "description": "ID of the Campaign this user belongs to"
    },
    "campaign_role": {
      "type": "string",
      "enum": [
        "campaign_admin",
        "organizer",
        "canvasser",
        "viewer"
      ],
      "default": "canvasser",
      "description": "Role within their specific campaign"
    },
    "custom_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extra permissions granted on top of the role defaults"
    },
    "revoked_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Permissions explicitly removed from the role defaults"
    }
  },
  "required": [
    "custom_permissions",
    "revoked_permissions"
  ]
}