{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "campaign_owner",
        "volunteer",
        "user"
      ],
      "default": "user",
      "description": "User's role in the platform"
    },
    "campaign_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of campaign IDs the user has access to"
    },
    "permissions": {
      "type": "object",
      "description": "Campaign-level permissions (campaign_id -> role)"
    },
    "phone": {
      "type": "string",
      "description": "User's phone number"
    },
    "preferences": {
      "type": "object",
      "properties": {
        "email_notifications": {
          "type": "boolean",
          "default": true
        },
        "sms_notifications": {
          "type": "boolean",
          "default": false
        },
        "weekly_summary": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "User communication preferences"
    },
    "two_factor_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether 2FA is enabled"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether user completed initial onboarding"
    },
    "last_login": {
      "type": "string",
      "format": "date-time",
      "description": "Last login timestamp"
    }
  },
  "required": [
    "campaign_ids",
    "permissions",
    "phone",
    "preferences",
    "last_login"
  ]
}