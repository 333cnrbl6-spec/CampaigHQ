{
  "name": "LeafletRun",
  "type": "object",
  "properties": {
    "street_name": {
      "type": "string",
      "description": "Street or road name"
    },
    "area": {
      "type": "string",
      "enum": [
        "Tyldesley",
        "Mosley Common",
        "Astley",
        "Other"
      ],
      "default": "Tyldesley"
    },
    "postcode": {
      "type": "string"
    },
    "turf_id": {
      "type": "string",
      "description": "ID of the parent Turf record this street belongs to"
    },
    "turf_part": {
      "type": "string",
      "description": "Sub-division of the turf if split, e.g. 'A', 'B', 'C'"
    },
    "round_number": {
      "type": "number",
      "description": "Which leaflet round this is for (1, 2, or 3). 0 = all rounds.",
      "default": 0
    },
    "round_1_done": {
      "type": "boolean",
      "default": false,
      "description": "Round 1 (all households) completed on this street"
    },
    "round_2_done": {
      "type": "boolean",
      "default": false,
      "description": "Round 2 (postal voters only) completed on this street"
    },
    "round_3_done": {
      "type": "boolean",
      "default": false,
      "description": "Round 3 (all except postal voters) completed on this street"
    },
    "postal_voter_houses": {
      "type": "number",
      "default": 0,
      "description": "Number of postal voter addresses on this street (skip on round 3)"
    },
    "assigned_to": {
      "type": "string",
      "description": "Volunteer name assigned to this street"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed"
      ],
      "default": "not_started"
    },
    "leaflets_delivered": {
      "type": "number",
      "default": 0,
      "description": "Number of leaflets delivered on this street (all rounds combined)"
    },
    "total_houses": {
      "type": "number",
      "default": 0,
      "description": "Estimated number of houses on this street"
    },
    "notes": {
      "type": "string"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "street_name"
  ]
}