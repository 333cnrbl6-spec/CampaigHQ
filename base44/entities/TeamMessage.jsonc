{
  "name": "TeamMessage",
  "type": "object",
  "properties": {
    "from": {
      "type": "string",
      "description": "Sender email"
    },
    "from_name": {
      "type": "string",
      "description": "Sender name"
    },
    "to": {
      "type": "string",
      "description": "Recipient email"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "event_related": {
      "type": "string",
      "description": "Event ID if this is about an event"
    }
  },
  "required": [
    "from",
    "to",
    "message"
  ]
}